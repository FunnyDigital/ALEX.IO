# ALEX.IO server configuration
# Copy this file to .env and adjust as needed.

# Run mode:
#   auto (default) -> uses Firebase when credentials are found, otherwise demo mode
#   demo           -> force the local JSON store (no Firebase, no keys required)
#   firebase       -> force Firebase
# DEMO_MODE=auto

PORT=5000
HOST=0.0.0.0

# 30-day token signing secret for demo-mode auth
JWT_SECRET=change-me-to-a-long-random-string

# Comma separated list of allowed origins, or leave unset to allow all
# CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# ---- Firebase (optional) ----
# Provide ONE of the following to enable Firebase mode:
# 1) Path to a service account JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=./alexio-service-account.json
# 2) Service account fields as environment variables:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY_ID=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_CLIENT_ID=

# ---- Paystack (optional, real deposits/payouts) ----
# PAYSTACK_SECRET_KEY=sk_test_xxx
