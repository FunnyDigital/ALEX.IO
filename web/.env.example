# ALEX.IO web app configuration. Copy to .env.local to override.

# API base URL. Leave unset to use same-origin "/api" (recommended).
# VITE_API_URL=http://localhost:5000/api

# Paystack public key — enables real card deposits. Unset = demo deposits.
# VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Firebase (optional) — set all four to enable Firebase auth instead of demo auth.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
